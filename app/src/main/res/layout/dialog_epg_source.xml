<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="4dp">

        <EditText
            android:id="@+id/epg_source_name"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Название (например, «Основной EPG»)"
            android:inputType="text"
            android:maxLines="1"
            android:singleLine="true"
            android:textColor="@color/text"
            android:textColorHint="#55657A"
            android:textSize="15sp" />

        <EditText
            android:id="@+id/epg_source_url"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:hint="URL XMLTV (.xml или .xml.gz)"
            android:inputType="textUri"
            android:maxLines="1"
            android:singleLine="true"
            android:textColor="@color/text"
            android:textColorHint="#55657A"
            android:textSize="15sp" />

        <EditText
            android:id="@+id/epg_source_priority"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:hint="Приоритет: 1 — главный, 2 — резервный"
            android:inputType="number"
            android:maxLines="1"
            android:singleLine="true"
            android:textColor="@color/text"
            android:textColorHint="#55657A"
            android:textSize="15sp" />

        <CheckBox
            android:id="@+id/epg_source_gzip"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:buttonTint="@color/accent"
            android:text="Источник отдаёт gzip (определяется автоматически)"
            android:textColor="@color/text"
            android:textSize="14sp" />

    </LinearLayout>

</ScrollView>
