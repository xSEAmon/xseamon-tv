<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@android:color/black">

    <androidx.media3.ui.PlayerView
        android:id="@+id/player_view"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        app:resize_mode="fit"
        app:show_buffering="when_playing"
        app:use_controller="false" />

    <View
        android:id="@+id/touch_layer"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@android:color/transparent"
        android:clickable="true"
        android:focusable="false" />

    <LinearLayout
        android:id="@+id/overlay"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:background="@drawable/overlay_bg"
        android:orientation="vertical"
        android:paddingStart="@dimen/player_horizontal_padding"
        android:paddingTop="@dimen/player_top_padding"
        android:paddingEnd="@dimen/player_horizontal_padding"
        android:paddingBottom="@dimen/player_bottom_padding">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/channel_number"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="24dp"
                android:minWidth="44dp"
                android:textColor="@color/accent"
                android:textSize="@dimen/player_number_size"
                android:textStyle="bold" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/channel_name"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:ellipsize="end"
                    android:maxLines="1"
                    android:textColor="@color/text"
                    android:textSize="@dimen/player_name_size"
                    android:textStyle="bold" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/live_badge"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginEnd="8dp"
                        android:background="@drawable/badge_bg"
                        android:paddingStart="6dp"
                        android:paddingTop="1dp"
                        android:paddingEnd="6dp"
                        android:paddingBottom="1dp"
                        android:text="● LIVE"
                        android:textColor="@color/hd"
                        android:textSize="11sp"
                        android:textStyle="bold"
                        android:visibility="gone" />

                    <TextView
                        android:id="@+id/channel_meta"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:textColor="@color/text_dim"
                        android:textSize="14sp" />

                </LinearLayout>

                <TextView
                    android:id="@+id/channel_now"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:ellipsize="end"
                    android:maxLines="3"
                    android:textColor="@color/text"
                    android:textSize="15sp" />

                <ProgressBar
                    android:id="@+id/channel_progress"
                    style="?android:attr/progressBarStyleHorizontal"
                    android:layout_width="match_parent"
                    android:layout_height="3dp"
                    android:layout_marginTop="6dp"
                    android:max="1000"
                    android:progressTint="@color/accent"
                    android:visibility="gone" />

            </LinearLayout>

        </LinearLayout>

        <HorizontalScrollView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:scrollbars="none">

            <LinearLayout
                android:id="@+id/player_controls"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/btn_play"
                    style="@style/PlayerChip"
                    android:drawableStart="@drawable/ic_pause"
                    android:drawablePadding="8dp"
                    android:text="Пауза" />

                <TextView
                    android:id="@+id/btn_schedule"
                    style="@style/PlayerChip"
                    android:drawableStart="@drawable/ic_list"
                    android:drawablePadding="8dp"
                    android:text="Программа" />

                <TextView
                    android:id="@+id/btn_quality"
                    style="@style/PlayerChip"
                    android:drawableStart="@drawable/ic_quality"
                    android:drawablePadding="8dp"
                    android:text="Качество" />

                <TextView
                    android:id="@+id/btn_back"
                    style="@style/PlayerChip"
                    android:drawableStart="@drawable/ic_back"
                    android:drawablePadding="8dp"
                    android:text="Назад" />

            </LinearLayout>

        </HorizontalScrollView>

    </LinearLayout>

    <LinearLayout
        android:id="@+id/error_view"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:background="@drawable/error_bg"
        android:gravity="center_horizontal"
        android:minWidth="320dp"
        android:orientation="vertical"
        android:padding="32dp"
        android:visibility="gone">

        <TextView
            android:id="@+id/error_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="@color/text"
            android:textSize="24sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/error_hint"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:gravity="center"
            android:textColor="@color/text_dim"
            android:textSize="15sp" />

        <TextView
            android:id="@+id/error_technical"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:gravity="center"
            android:maxLines="3"
            android:textColor="#66788C"
            android:textSize="11sp"
            android:visibility="gone" />

        <TextView
            android:id="@+id/btn_retry"
            style="@style/PlayerChip"
            android:layout_marginTop="18dp"
            android:drawableStart="@drawable/ic_refresh"
            android:drawablePadding="8dp"
            android:text="Повторить" />

    </LinearLayout>

</FrameLayout>
