<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/card_bg"
    android:clickable="true"
    android:focusable="true"
    android:orientation="vertical"
    android:padding="4dp">

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="96dp"
        android:background="@drawable/thumb_bg">

        <TextView
            android:id="@+id/card_initial"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:gravity="center"
            android:textColor="#243447"
            android:textSize="24sp"
            android:textStyle="bold" />

        <ImageView
            android:id="@+id/card_logo"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:contentDescription="@null"
            android:padding="10dp"
            android:scaleType="fitCenter" />

        <TextView
            android:id="@+id/card_badge"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="top|start"
            android:layout_margin="4dp"
            android:background="@drawable/badge_bg"
            android:paddingStart="5dp"
            android:paddingTop="1dp"
            android:paddingEnd="5dp"
            android:paddingBottom="1dp"
            android:textColor="@color/text"
            android:textSize="10sp" />

        <TextView
            android:id="@+id/card_quality"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="top|end"
            android:layout_margin="4dp"
            android:background="@drawable/quality_bg"
            android:paddingStart="5dp"
            android:paddingTop="1dp"
            android:paddingEnd="5dp"
            android:paddingBottom="1dp"
            android:textColor="#06120A"
            android:textSize="9sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/card_fav"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="bottom|end"
            android:layout_margin="3dp"
            android:text="★"
            android:textColor="@color/accent"
            android:textSize="12sp"
            android:visibility="gone" />

        <TextView
            android:id="@+id/card_archive"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="bottom|start"
            android:layout_margin="3dp"
            android:background="@drawable/badge_bg"
            android:paddingStart="4dp"
            android:paddingTop="1dp"
            android:paddingEnd="4dp"
            android:paddingBottom="1dp"
            android:text="АРХИВ"
            android:textColor="@color/text_dim"
            android:textSize="7sp"
            android:visibility="gone" />

    </FrameLayout>

    <TextView
        android:id="@+id/card_title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:ellipsize="end"
        android:maxLines="1"
        android:textColor="@color/text"
        android:textSize="12sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/card_now"
        android:layout_width="match_parent"
        android:layout_height="14dp"
        android:ellipsize="end"
        android:maxLines="1"
        android:textColor="@color/text_dim"
        android:textSize="10sp" />

</LinearLayout>
