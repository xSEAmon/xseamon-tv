<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg"
    android:orientation="vertical">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="@dimen/top_bar_height"
        android:background="@drawable/top_bar_bg"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="@dimen/screen_padding"
        android:paddingEnd="@dimen/screen_padding">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:letterSpacing="0.02"
            android:text="Антон ТВ"
            android:textColor="@color/accent"
            android:textSize="22sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/top_subtitle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="18dp"
            android:layout_weight="1"
            android:ellipsize="end"
            android:maxLines="1"
            android:textColor="@color/text_dim"
            android:textSize="14sp" />

        <TextView
            android:id="@+id/top_hint"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="@color/text_dim"
            android:textSize="13sp" />

        <TextView
            android:id="@+id/btn_search"
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:clickable="true"
            android:contentDescription="Поиск"
            android:focusable="true"
            android:gravity="center"
            android:paddingStart="14dp"
            android:paddingEnd="4dp"
            android:text="Поиск"
            android:textColor="@color/accent"
            android:textSize="15sp" />

    </LinearLayout>

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <FrameLayout
            android:id="@+id/rows_container"
            android:layout_width="match_parent"
            android:layout_height="match_parent" />

        <ProgressBar
            android:id="@+id/progress"
            android:layout_width="56dp"
            android:layout_height="56dp"
            android:layout_gravity="center"
            android:indeterminateTint="@color/accent" />

        <LinearLayout
            android:id="@+id/skeleton"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical"
            android:paddingStart="@dimen/safe_horizontal"
            android:paddingTop="@dimen/safe_vertical"
            android:paddingEnd="@dimen/safe_horizontal"
            android:paddingBottom="@dimen/safe_vertical"
            android:visibility="gone">

            <View
                android:layout_width="180dp"
                android:layout_height="18dp"
                android:layout_marginBottom="18dp"
                android:background="@drawable/skeleton_card" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <View style="@style/SkeletonCard" />
                <View style="@style/SkeletonCard" />
                <View style="@style/SkeletonCard" />
                <View style="@style/SkeletonCard" />
                <View style="@style/SkeletonCard" />
                <View style="@style/SkeletonCard" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:orientation="horizontal">

                <View style="@style/SkeletonCard" />
                <View style="@style/SkeletonCard" />
                <View style="@style/SkeletonCard" />
                <View style="@style/SkeletonCard" />
                <View style="@style/SkeletonCard" />
                <View style="@style/SkeletonCard" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:orientation="horizontal">

                <View style="@style/SkeletonCard" />
                <View style="@style/SkeletonCard" />
                <View style="@style/SkeletonCard" />
                <View style="@style/SkeletonCard" />
                <View style="@style/SkeletonCard" />
                <View style="@style/SkeletonCard" />
            </LinearLayout>

        </LinearLayout>

        <TextView
            android:id="@+id/status"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:gravity="center"
            android:padding="24dp"
            android:textColor="@color/text_dim"
            android:textSize="16sp" />

        <TextView
            android:id="@+id/number_overlay"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:background="@drawable/dialog_bg"
            android:minWidth="120dp"
            android:gravity="center"
            android:paddingStart="28dp"
            android:paddingTop="16dp"
            android:paddingEnd="28dp"
            android:paddingBottom="16dp"
            android:textColor="@color/accent"
            android:textSize="34sp"
            android:textStyle="bold"
            android:visibility="gone" />

    </FrameLayout>

</LinearLayout>
