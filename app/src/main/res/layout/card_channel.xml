<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="@dimen/card_width"
    android:layout_height="wrap_content"
    android:background="@drawable/card_bg"
    android:clipChildren="false"
    android:clipToPadding="false"
    android:focusable="true"
    android:focusableInTouchMode="true"
    android:orientation="vertical"
    android:padding="@dimen/card_padding">

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="@dimen/card_thumb_height"
        android:background="@drawable/thumb_bg">

        <TextView
            android:id="@+id/card_initial"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:gravity="center"
            android:textColor="#243447"
            android:textSize="@dimen/card_initial_size"
            android:textStyle="bold" />

        <ImageView
            android:id="@+id/card_logo"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:contentDescription="@null"
            android:padding="@dimen/card_logo_padding"
            android:scaleType="fitCenter" />

        <TextView
            android:id="@+id/card_badge"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="top|start"
            android:layout_margin="6dp"
            android:background="@drawable/badge_bg"
            android:paddingStart="6dp"
            android:paddingTop="2dp"
            android:paddingEnd="6dp"
            android:paddingBottom="2dp"
            android:textColor="@color/text"
            android:textSize="11sp" />

        <TextView
            android:id="@+id/card_quality"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="top|end"
            android:layout_margin="6dp"
            android:background="@drawable/quality_bg"
            android:paddingStart="6dp"
            android:paddingTop="2dp"
            android:paddingEnd="6dp"
            android:paddingBottom="2dp"
            android:textColor="#06120A"
            android:textSize="10sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/card_action"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:gravity="center"
            android:padding="10dp"
            android:textColor="@color/text"
            android:textSize="17sp"
            android:textStyle="bold"
            android:visibility="gone" />

        <TextView
            android:id="@+id/card_fav"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="bottom|end"
            android:layout_margin="4dp"
            android:text="★"
            android:textColor="@color/accent"
            android:textSize="14sp"
            android:visibility="gone" />

        <TextView
            android:id="@+id/card_archive"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="bottom|start"
            android:layout_margin="4dp"
            android:background="@drawable/badge_bg"
            android:paddingStart="5dp"
            android:paddingTop="1dp"
            android:paddingEnd="5dp"
            android:paddingBottom="1dp"
            android:text="АРХИВ"
            android:textColor="@color/text_dim"
            android:textSize="8sp"
            android:visibility="gone" />

    </FrameLayout>

    <TextView
        android:id="@+id/card_title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:ellipsize="end"
        android:maxLines="1"
        android:textColor="@color/text"
        android:textSize="@dimen/card_title_size"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/card_now"
        android:layout_width="match_parent"
        android:layout_height="16dp"
        android:ellipsize="end"
        android:maxLines="1"
        android:textColor="@color/text_dim"
        android:textSize="@dimen/card_now_size" />

</LinearLayout>
